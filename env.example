# whisper-srt environment configuration
#
# These variables are ONLY used when --llm-resolve-unmatched is enabled.
# The default whisper-srt flow does not call any LLM and does not require
# an API key.
#
# Copy this file to .env and fill in your values.

# OpenRouter API key. Required only for --llm-resolve-unmatched.
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: override the default LLM model used by the index resolver.
# Default: google/gemini-2.5-flash
# LLM_MODEL=google/gemini-2.5-flash

# Optional: override the OpenRouter base URL.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
