# whisper-srt Environment Configuration
# Copy this file to .env and fill in your values

# OpenRouter API Key (required for reference text alignment)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# LLM Model for alignment (optional)
# Default: google/gemini-3-flash-preview
# Other options: google/gemini-2.5-flash, anthropic/claude-sonnet-4, openai/gpt-4o-mini
# LLM_MODEL=google/gemini-3-flash-preview

# OpenRouter Base URL (optional, for custom endpoints)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

